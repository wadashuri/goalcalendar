    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-sharing"
    ],
    "scheme": "goalcalendar",
    "platforms": ["ios"],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "37c20f07-10f8-4f37-9d34-03a02e3ee96d"
      }
    },
    "owner": "shuri0108"
  }
